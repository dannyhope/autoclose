{
	"name": "autoclose",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:chrome": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"build:all": "npm run build:chrome && npm run build:firefox",
		"zip": "wxt zip",
		"zip:chrome": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"preview": "wxt preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"legacy:dev": "./scripts/ensure-local-domain.sh && ./scripts/dev.mjs",
		"legacy:build": "vite build",
		"legacy:build:chrome": "node build-targets.mjs chrome",
		"legacy:build:firefox": "node build-targets.mjs firefox",
		"legacy:build:safari": "node build-targets.mjs safari"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/chrome": "^0.2.7",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@types/webextension-polyfill": "^0.12.6",
		"@vitejs/plugin-react": "^5.2.0",
		"@wxt-dev/module-react": "^1.2.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^7.3.6",
		"vitest": "^3.0.0",
		"webextension-polyfill": "^0.12.0",
		"wxt": "^0.21.4"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.34.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0"
	}
